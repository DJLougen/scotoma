{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scrub N Paste",
  "version": "0.1.0",
  "identifier": "app.scotoma.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Scrub N Paste",
        "width": 1080,
        "height": 700,
        "minWidth": 820,
        "minHeight": 480,
        "visible": false,
        "center": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "models/**/*",
      "bin/*"
    ]
  }
}